<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --bg-deep: #0e0c09;
  --bg-dark: #1a1814;
  --bg-card: #23201a;
  --bg-card-hover: #2e2a22;
  --gold: #c4a265;
  --gold-light: #d4b878;
  --gold-pale: #e8d5a8;
  --gold-glow: rgba(196, 162, 101, 0.15);
  --text: #d6cfc0;
  --text-dim: #9a9284;
  --text-bright: #f0ebe0;
  --accent: #8a6d3b;
  --border: rgba(196, 162, 101, 0.2);
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Cormorant Garamond', Georgia, serif;
  background: var(--bg-deep);
  color: var(--text);
  line-height: 1.7;
  overflow-x: hidden;
}

/* ─── Decorative Elements ─── */
.ornament {
  display: block;
  text-align: center;
  color: var(--gold);
  font-size: 2rem;
  letter-spacing: 1em;
  margin: 2rem auto;
  opacity: 0.5;
}

/* ─── HERO ─── */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem;
  position: relative;
  background:
    radial-gradient(ellipse at 50% 30%, rgba(196, 162, 101, 0.08) 0%, transparent 60%),
    radial-gradient(ellipse at 50% 80%, rgba(100, 70, 30, 0.06) 0%, transparent 50%),
    var(--bg-deep);
}

.hero::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23c4a265' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  opacity: 0.5;
  pointer-events: none;
}

.hero-badge {
  font-family: 'Cinzel', serif;
  font-size: 0.75rem;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  color: var(--gold);
  border: 1px solid var(--border);
  padding: 0.5em 1.5em;
  margin-bottom: 2rem;
  display: inline-block;
}

.hero h1 {
  font-family: 'Cinzel', serif;
  font-size: clamp(2.5rem, 7vw, 5rem);
  font-weight: 700;
  color: var(--gold-light);
  letter-spacing: 0.06em;
  line-height: 1.15;
  margin-bottom: 0.3em;
  text-shadow: 0 0 60px rgba(196, 162, 101, 0.2);
}

.hero h1 span {
  display: block;
  font-size: 0.35em;
  letter-spacing: 0.25em;
  color: var(--text-dim);
  font-weight: 400;
  margin-top: 0.5em;
}

.hero-subtitle {
  font-size: clamp(1.1rem, 2.5vw, 1.5rem);
  font-style: italic;
  color: var(--text);
  max-width: 600px;
  margin: 1.5rem auto 2.5rem;
}

.hero-cta {
  display: inline-block;
  font-family: 'Cinzel', serif;
  font-size: 0.9rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--bg-deep);
  background: linear-gradient(135deg, var(--gold), var(--gold-light));
  padding: 1em 3em;
  text-decoration: none;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
}
.hero-cta:hover {
  background: linear-gradient(135deg, var(--gold-light), var(--gold-pale));
  box-shadow: 0 0 40px rgba(196, 162, 101, 0.3);
  transform: translateY(-2px);
}

/* ─── SECTIONS ─── */
section {
  padding: 5rem 2rem;
  max-width: 1100px;
  margin: 0 auto;
}

.section-title {
  font-family: 'Cinzel', serif;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 600;
  color: var(--gold-light);
  text-align: center;
  margin-bottom: 1rem;
  letter-spacing: 0.05em;
}

.section-lead {
  text-align: center;
  font-size: 1.2rem;
  color: var(--text-dim);
  max-width: 700px;
  margin: 0 auto 3rem;
  font-style: italic;
}

/* ─── ABOUT ─── */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}

.about-text p {
  font-size: 1.15rem;
  margin-bottom: 1.5rem;
  color: var(--text);
}

.about-text p strong {
  color: var(--gold-light);
  font-weight: 600;
}

.about-visual {
  display: flex;
  justify-content: center;
  gap: 1rem;
  perspective: 800px;
}

.card-fan-item {
  width: 160px;
  border-radius: 8px;
  overflow: hidden;
  border: 2px solid var(--border);
  transition: transform 0.4s ease, box-shadow 0.4s ease;
  box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}
.card-fan-item img {
  display: block;
  width: 100%;
  height: auto;
}
.card-fan-item:nth-child(1) { transform: rotate(-8deg); }
.card-fan-item:nth-child(2) { transform: rotate(0deg) translateY(-10px); z-index: 2; }
.card-fan-item:nth-child(3) { transform: rotate(8deg); }
.card-fan-item:hover {
  box-shadow: 0 15px 40px rgba(196, 162, 101, 0.15);
  border-color: var(--gold);
}

/* ─── ARCANA SHOWCASE ─── */
.arcana-section {
  background: linear-gradient(180deg, transparent, var(--bg-dark) 10%, var(--bg-dark) 90%, transparent);
  padding: 5rem 2rem;
  max-width: 100%;
}
.arcana-section .inner { max-width: 1100px; margin: 0 auto; }

.arcana-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1.5rem;
  margin-top: 2rem;
}

.arcana-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 2rem 1.2rem;
  text-align: center;
  transition: all 0.3s ease;
}
.arcana-card.has-image {
  padding: 1rem 1rem 1.5rem;
}
.arcana-card:hover {
  background: var(--bg-card-hover);
  border-color: var(--gold);
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.4);
}

.arcana-card .card-img {
  width: 100%;
  height: auto;
  aspect-ratio: 340 / 582;
  object-fit: cover;
  border-radius: 4px;
  margin-bottom: 1rem;
  border: 1px solid var(--border);
  transition: border-color 0.3s ease;
}
.arcana-card:hover .card-img { border-color: var(--gold); }

.arcana-card .card-num {
  font-family: 'Cinzel', serif;
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--gold);
  line-height: 1;
  display: block;
  margin-bottom: 0.5rem;
}
.arcana-card.has-image .card-num {
  font-size: 1.2rem;
  margin-bottom: 0.3rem;
}

.arcana-card .card-name {
  font-family: 'Cinzel', serif;
  font-size: 1rem;
  font-weight: 600;
  color: var(--gold-pale);
  letter-spacing: 0.05em;
  display: block;
  margin-bottom: 0.8rem;
}
.arcana-card.has-image .card-name {
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
}

.arcana-card .card-meaning {
  font-size: 0.95rem;
  font-style: italic;
  color: var(--text-dim);
  line-height: 1.5;
}
.arcana-card.has-image .card-meaning {
  font-size: 0.85rem;
}

/* ─── FEATURES ─── */
.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
}

.feature-item {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 2rem;
  text-align: center;
  transition: border-color 0.3s ease;
}
.feature-item:hover { border-color: var(--gold); }

.feature-icon {
  font-size: 2.5rem;
  margin-bottom: 1rem;
  display: block;
}

.feature-item h3 {
  font-family: 'Cinzel', serif;
  font-size: 1.1rem;
  color: var(--gold-light);
  margin-bottom: 0.8rem;
  font-weight: 600;
}

.feature-item p {
  font-size: 1rem;
  color: var(--text-dim);
}

/* ─── WHAT'S IN THE BOX ─── */
.box-contents {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin-top: 2rem;
}

.box-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 6px;
}

.box-item .bi-icon {
  font-size: 2rem;
  flex-shrink: 0;
}

.box-item h4 {
  font-family: 'Cinzel', serif;
  font-size: 1rem;
  color: var(--gold-light);
  margin-bottom: 0.4rem;
}

.box-item p {
  font-size: 0.95rem;
  color: var(--text-dim);
}

/* ─── PRICING ─── */
.pricing-section {
  text-align: center;
  background: linear-gradient(180deg, transparent, var(--bg-dark) 15%, var(--bg-dark) 85%, transparent);
  padding: 5rem 2rem;
  max-width: 100%;
}
.pricing-section .inner { max-width: 800px; margin: 0 auto; }

.price-card {
  background: var(--bg-card);
  border: 2px solid var(--gold);
  border-radius: 8px;
  padding: 3rem 2rem;
  max-width: 480px;
  margin: 2rem auto;
  box-shadow: 0 0 60px var(--gold-glow);
}

.price-card .edition-label {
  font-family: 'Cinzel', serif;
  font-size: 0.75rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 1rem;
}

.price-card .price {
  font-family: 'Cinzel', serif;
  font-size: 3.5rem;
  font-weight: 700;
  color: var(--gold-light);
  line-height: 1;
  margin-bottom: 0.3rem;
}

.price-card .price-note {
  font-size: 1rem;
  color: var(--text-dim);
  font-style: italic;
  margin-bottom: 2rem;
}

.price-card ul {
  list-style: none;
  text-align: left;
  margin-bottom: 2rem;
}

.price-card li {
  padding: 0.6em 0;
  border-bottom: 1px solid rgba(196, 162, 101, 0.1);
  font-size: 1.05rem;
  color: var(--text);
}

.price-card li::before {
  content: '✦ ';
  color: var(--gold);
}

.price-cta {
  display: inline-block;
  font-family: 'Cinzel', serif;
  font-size: 1rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--bg-deep);
  background: linear-gradient(135deg, var(--gold), var(--gold-light));
  padding: 1em 3em;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  width: 100%;
}
.price-cta:hover {
  background: linear-gradient(135deg, var(--gold-light), var(--gold-pale));
  box-shadow: 0 0 40px rgba(196, 162, 101, 0.3);
}

.limited-note {
  margin-top: 1.5rem;
  font-size: 0.9rem;
  color: var(--text-dim);
  font-style: italic;
}

/* ─── LANGUAGES ─── */
.languages {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin-top: 2rem;
  flex-wrap: wrap;
}

.lang-badge {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 1rem 2rem;
  text-align: center;
  min-width: 140px;
}

.lang-badge .flag { font-size: 2rem; display: block; margin-bottom: 0.3rem; }
.lang-badge .lang-name {
  font-family: 'Cinzel', serif;
  font-size: 0.85rem;
  color: var(--gold-light);
  letter-spacing: 0.1em;
}

/* ─── FOOTER ─── */
footer {
  text-align: center;
  padding: 3rem 2rem;
  border-top: 1px solid var(--border);
  max-width: 1100px;
  margin: 0 auto;
}

footer p {
  font-size: 0.9rem;
  color: var(--text-dim);
}

footer a { color: var(--gold); text-decoration: none; }
footer a:hover { color: var(--gold-light); }

.footer-brand {
  font-family: 'Cinzel', serif;
  font-size: 0.8rem;
  letter-spacing: 0.2em;
  color: var(--text-dim);
  margin-top: 1rem;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 768px) {
  .about-grid { grid-template-columns: 1fr; }
  .box-contents { grid-template-columns: 1fr; }
  .about-visual { margin-top: 2rem; }
  .arcana-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 480px) {
  /* two columns, not one: 22 cards in a single column is a 13,500px scroll */
  .arcana-grid { grid-template-columns: repeat(2, 1fr); gap: 0.9rem; }
  .arcana-card.has-image { padding: 0.6rem 0.6rem 1rem; }
  .arcana-card.has-image .card-name { font-size: 0.82rem; }
  .arcana-card.has-image .card-meaning { font-size: 0.72rem; }
  /* the fan is rotated, so its bounding box is wider than the cards */
  .card-fan-item { width: 84px; }
}

/* rotated fan must never push the page wider than the viewport */
.about-visual { max-width: 100%; overflow-x: clip; }
.about-grid { min-width: 0; }
.about-text, .about-visual { min-width: 0; }


/* ─── LANGUAGE SWITCHER ─── */
.lang-switcher {
  position: fixed;
  top: 1.5rem;
  right: 1.5rem;
  z-index: 100;
  display: flex;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  background: rgba(14, 12, 9, 0.85);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
.lang-btn {
  font-family: 'Cinzel', serif;
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  padding: 0.6em 1.1em;
  background: transparent;
  color: var(--text-dim);
  border: none;
  cursor: pointer;
  transition: all 0.25s ease;
  border-right: 1px solid var(--border);
}
.lang-btn:last-child { border-right: none; }
.lang-btn:hover { color: var(--gold-light); }
.lang-btn.active {
  background: var(--gold);
  color: var(--bg-deep);
  font-weight: 600;
}

/* ─── ANIMATION ─── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

.hero h1, .hero-badge, .hero-subtitle, .hero-cta {
  animation: fadeUp 1s ease-out both;
}
.hero-badge { animation-delay: 0.1s; }
.hero h1 { animation-delay: 0.3s; }
.hero-subtitle { animation-delay: 0.6s; }
.hero-cta { animation-delay: 0.9s; }

/* ── order form / email capture ───────────────────────────── */
.edition-pick { margin: 0 0 1.6rem; text-align: left; }
.edition-pick > span { display:block; font-size:.72rem; letter-spacing:.18em; text-transform:uppercase; color:var(--gold); margin-bottom:.6rem; text-align:center; }
.edition-opts { display:flex; gap:.5rem; justify-content:center; }
.edition-opts label { flex:1; }
.edition-opts input { position:absolute; opacity:0; width:0; height:0; }
.edition-opts span { display:block; text-align:center; padding:.6rem .3rem; border:1px solid var(--border);
  border-radius:5px; cursor:pointer; font-size:.85rem; color:var(--text-dim); transition:all .2s ease; }
.edition-opts input:checked + span { border-color:var(--gold); color:var(--gold-pale); background:var(--gold-glow); }
.edition-opts input:focus-visible + span { outline:2px solid var(--gold); outline-offset:2px; }
.edition-opts span:hover { color:var(--text-bright); border-color:var(--gold); }

.capture { margin-top:1.4rem; text-align:left; }
.capture.is-hidden { display:none; }
.capture > p { font-size:.9rem; color:var(--text-dim); margin:0 0 .8rem; text-align:center; }
.capture-row { display:flex; gap:.5rem; }
.capture input[type=email] { flex:1; min-width:0; padding:.85rem 1rem; border-radius:5px;
  border:1px solid var(--border); background:rgba(0,0,0,.35); color:var(--text-bright); font-size:.95rem; font-family:inherit; }
.capture input[type=email]:focus { outline:none; border-color:var(--gold); box-shadow:0 0 0 3px var(--gold-glow); }
.capture button { padding:.85rem 1.4rem; border:none; border-radius:5px; cursor:pointer;
